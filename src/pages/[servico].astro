---
// Gera uma página para cada item de src/data/paginas.ts (ex.: /cnh-moto/, /adicao-de-categoria/).
// Para mudar textos, edite o arquivo de dados, não este.
import { Check, ChevronRight } from '@lucide/astro';
import Base from '@/layouts/Base.astro';
import ComoFunciona from '@/components/ComoFunciona.astro';
import Contato from '@/components/Contato.astro';
import { paginas, type PaginaServico } from '@/data/paginas';
import { categorias, incluido, planosDa, resumoDa, formatarReais } from '@/data/pacotes';
import { site } from '@/data/site';
import { linkWhatsApp } from '@/lib/whatsapp';

export function getStaticPaths() {
  return paginas.map((pagina) => ({ params: { servico: pagina.slug }, props: { pagina } }));
}

const { pagina } = Astro.props as { pagina: PaginaServico };
const url = new URL(`/${pagina.slug}/`, site.url).href;
const resumo = pagina.categoria && resumoDa(pagina.categoria);
const outras = paginas.filter((p) => p.slug !== pagina.slug);

// Diz ao Google qual serviço esta página oferece, quem oferece e onde.
const servicoSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: pagina.nome,
  description: pagina.descricao,
  url,
  provider: { '@id': `${site.url}/#autoescola` },
  areaServed: { '@type': 'City', name: `${site.endereco.cidade}, ${site.endereco.estado}` },
  ...(resumo && {
    offers: { '@type': 'Offer', price: resumo.aPartirDe, priceCurrency: 'BRL', url },
  }),
};

// O "caminho" que o Google mostra no resultado: CFC Querência › CNH de moto
const caminhoSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: site.nome, item: `${site.url}/` },
    { '@type': 'ListItem', position: 2, name: pagina.nome, item: url },
  ],
};
---

<Base title={pagina.titulo} description={pagina.descricao} schema={[servicoSchema, caminhoSchema]}>
  <section class="faixa-pista relative overflow-hidden bg-marca pb-20 text-white">
    <div class="absolute -top-40 -left-40 size-[32rem] rounded-full bg-white/10 blur-3xl" aria-hidden="true"></div>
    <div class="container-site relative pt-10 sm:pt-14">
      <nav aria-label="Você está em" class="entrada text-sm text-white/80">
        <ol class="flex items-center gap-1.5">
          <li><a href="/" class="hover:text-white hover:underline">Início</a></li>
          <li aria-hidden="true"><ChevronRight class="size-4" /></li>
          <li aria-current="page" class="font-semibold text-white">{pagina.nome}</li>
        </ol>
      </nav>
      <h1 class="entrada mt-6 max-w-3xl text-4xl leading-[1.1] font-extrabold tracking-tight sm:text-5xl">{pagina.h1}</h1>
      <p class="entrada entrada-2 mt-5 max-w-2xl text-lg text-white/90">{pagina.chamada}</p>
      {
        resumo && (
          <p class="entrada entrada-2 mt-6 text-white/90">
            A partir de <strong class="text-3xl font-extrabold text-destaque">{formatarReais(resumo.aPartirDe, 0)}</strong> à vista ou em até{' '}
            {resumo.parcelas}x no cartão
          </p>
        )
      }
      <div class="entrada entrada-2 mt-8 flex flex-wrap gap-3">
        <a href={linkWhatsApp(pagina.mensagemWhatsApp)} class="btn-destaque shadow-lg shadow-black/20">Falar no WhatsApp</a>
        {resumo && <a href="/#planos" class="btn-contorno">Ver todos os planos</a>}
      </div>
    </div>
    <div class="estrada absolute inset-x-0 bottom-0 h-3" aria-hidden="true"></div>
  </section>

  <section class="container-site grid gap-10 py-16 sm:py-20 md:grid-cols-2">
    <div data-reveal>
      <h2 class="titulo-secao">Para quem é</h2>
      <ul class="mt-6 space-y-3 text-lg text-slate-700">
        {
          pagina.paraQuem.map((item) => (
            <li class="flex gap-3">
              <Check class="mt-1 size-5 shrink-0 text-marca" /> {item}
            </li>
          ))
        }
      </ul>
    </div>

    {
      pagina.categoria && (
        <div class="rounded-3xl border border-slate-200 p-6 sm:p-8" data-reveal>
          <h2 class="text-2xl font-extrabold text-slate-900">Planos {categorias[pagina.categoria].curto.toLowerCase()}</h2>
          <ul class="mt-5 divide-y divide-slate-200">
            {planosDa(pagina.categoria).map((p) => (
              <li class="flex items-center justify-between gap-4 py-3">
                <span class="font-semibold text-slate-900">{p.nome}</span>
                <span class="text-slate-600">
                  {[p.aulasMoto && `${p.aulasMoto} aulas de moto`, p.aulasCarro && `${p.aulasCarro} aulas de carro`].filter(Boolean).join(' + ')}
                </span>
              </li>
            ))}
          </ul>
          <p class="mt-4 text-sm text-slate-600">Todos incluem: {incluido[pagina.categoria].join(', ').toLowerCase()}.</p>
          <a href={linkWhatsApp(pagina.mensagemWhatsApp)} class="btn-whatsapp mt-6 w-full">Consultar valores no WhatsApp</a>
        </div>
      )
    }
  </section>

  {
    pagina.passos ? (
      <section class="bg-slate-50 py-16 sm:py-20">
        <div class="container-site">
          <h2 class="titulo-secao text-center" data-reveal>Como funciona</h2>
          <ol class="mx-auto mt-10 grid max-w-4xl gap-4 sm:grid-cols-2">
            {pagina.passos.map((p, i) => (
              <li class="flex gap-4 rounded-3xl bg-white p-6 shadow-sm" data-reveal style={`--atraso: ${(i % 2) * 100}ms`}>
                <span class="flex size-10 shrink-0 items-center justify-center rounded-full bg-marca font-extrabold text-white">{i + 1}</span>
                <div>
                  <h3 class="text-lg font-bold text-slate-900">{p.titulo}</h3>
                  <p class="mt-1 text-slate-600">{p.texto}</p>
                </div>
              </li>
            ))}
          </ol>
        </div>
      </section>
    ) : (
      <ComoFunciona />
    )
  }

  <section class="container-site py-16">
    <h2 class="titulo-secao text-center">Dúvidas frequentes</h2>
    <div class="mx-auto mt-10 max-w-3xl divide-y divide-slate-200 rounded-2xl border border-slate-200">
      {
        pagina.duvidas.map((item) => (
          <details class="group p-5">
            <summary class="flex cursor-pointer list-none items-center justify-between gap-4 font-semibold text-slate-900">
              {item.pergunta}
              <span class="text-2xl text-marca transition group-open:rotate-45">+</span>
            </summary>
            <p class="mt-3 text-slate-600">{item.resposta}</p>
          </details>
        ))
      }
    </div>
    <p class="mt-6 text-center text-slate-600">
      Tem outra dúvida? <a href="/#duvidas" class="font-semibold text-marca underline">Veja as perguntas frequentes</a>
    </p>
  </section>

  <Contato />

  <nav aria-label="Outros serviços" class="container-site py-12">
    <h2 class="text-xl font-extrabold text-slate-900">Outros serviços do CFC Querência</h2>
    <ul class="mt-4 flex flex-wrap gap-3">
      {
        outras.map((p) => (
          <li>
            <a href={`/${p.slug}/`} class="btn border-2 border-slate-300 hover:border-marca">{p.nome}</a>
          </li>
        ))
      }
    </ul>
  </nav>
</Base>
