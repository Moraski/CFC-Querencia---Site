---
// FAQ feito com <details>: abre e fecha sem nenhum JavaScript.
import { faq } from '@/data/faq';
---

<section id="duvidas" class="container-site scroll-mt-20 py-16">
  <h2 class="titulo-secao text-center">Dúvidas frequentes</h2>
  <div class="mx-auto mt-10 max-w-3xl divide-y divide-slate-200 rounded-2xl border border-slate-200">
    {
      faq.map((item) => (
        <details class="group p-5">
          <summary class="flex cursor-pointer list-none items-center justify-between gap-4 font-semibold text-slate-900">
            {item.pergunta}
            <span class="text-2xl text-marca transition group-open:rotate-45">+</span>
          </summary>
          <p class="mt-3 text-slate-600">{item.resposta}</p>
        </details>
      ))
    }
  </div>
</section>
