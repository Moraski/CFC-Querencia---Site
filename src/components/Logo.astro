---
// Logo oficial do CFC (imagem). `claro` usa a versão branca, para fundos escuros.
// TODO: trocar por uma versão em SVG do logo quando tiver, para ficar mais nítido.
import { Image } from 'astro:assets';
import logo from '@/assets/logo.png';
import logoBranco from '@/assets/logo-branco.png';

interface Props {
  claro?: boolean;
}
const { claro = false } = Astro.props;
---

<Image src={claro ? logoBranco : logo} alt="Auto Escola CFC Querência" class="h-9 w-auto sm:h-10" loading="eager" />
