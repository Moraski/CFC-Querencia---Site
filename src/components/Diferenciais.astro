---
import { diferenciais } from '@/data/servicos';
---

<section class="faixa-pista relative overflow-hidden bg-marca py-16 text-white sm:py-20">
  <div class="container-site relative">
    <h2 class="text-3xl font-extrabold sm:text-4xl" data-reveal>Por que o CFC Querência</h2>
    <ul class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
      {
        diferenciais.map((d, i) => (
          <li class="rounded-3xl bg-white/10 p-6 ring-1 ring-white/15 backdrop-blur-sm" data-reveal style={`--atraso: ${i * 80}ms`}>
            <d.icone class="size-9 text-destaque" stroke-width={1.75} />
            <h3 class="mt-4 text-lg font-bold">{d.titulo}</h3>
            <p class="mt-2 text-white/85">{d.texto}</p>
          </li>
        ))
      }
    </ul>
  </div>
</section>
