---
import Logo from '@/components/Logo.astro';
import { linkWhatsApp } from '@/lib/whatsapp';

const menu = [
  { texto: 'Como funciona', href: '/#como-funciona' },
  { texto: 'Planos', href: '/#planos' },
  { texto: 'Dúvidas', href: '/#duvidas' },
  { texto: 'Contato', href: '/#contato' },
];
---

<header class="sticky top-0 z-40 border-b border-slate-200/70 bg-white/90 backdrop-blur-md">
  <div class="container-site flex h-16 items-center justify-between gap-4">
    <a href="/" aria-label="CFC Querência, página inicial">
      <Logo />
    </a>

    <nav aria-label="Principal" class="hidden md:block">
      <ul class="flex gap-7 font-semibold text-slate-700">
        {
          menu.map((item) => (
            <li>
              <a href={item.href} class="relative py-1 transition hover:text-marca after:absolute after:inset-x-0 after:-bottom-0.5 after:h-0.5 after:origin-left after:scale-x-0 after:rounded after:bg-marca after:transition hover:after:scale-x-100">
                {item.texto}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <a href={linkWhatsApp()} class="btn-whatsapp min-h-10 px-4 text-sm">
      <span class="md:hidden">WhatsApp</span>
      <span class="hidden md:inline">Falar no WhatsApp</span>
    </a>
  </div>
</header>
