---
import { TriangleAlert } from '@lucide/astro';
import { passos } from '@/data/servicos';
---

<section id="como-funciona" class="scroll-mt-20 bg-slate-50 py-16 sm:py-20">
  <div class="container-site">
    <div data-reveal>
      <h2 class="titulo-secao text-center">Passo a passo da sua CNH</h2>
      <p class="mx-auto mt-3 max-w-2xl text-center text-slate-600">
        Primeira habilitação de moto e carro (AB) pelas regras novas, com os valores de cada etapa.
      </p>
    </div>
    <ol class="mt-12 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {
        passos.map((p, i) => (
          <li
            class:list={[
              'relative flex gap-4 rounded-3xl bg-white p-6 shadow-sm',
              p.alerta && 'ring-2 ring-destaque',
              p.final && 'sm:col-span-2 lg:col-span-1 lg:col-start-2',
            ]}
            data-reveal
            style={`--atraso: ${(i % 3) * 100}ms`}
          >
            <span class="relative flex size-14 shrink-0 items-center justify-center rounded-2xl bg-marca text-white shadow-lg shadow-marca/30">
              <p.icone class="size-7" stroke-width={1.75} />
              <span class="absolute -top-2 -right-2 flex size-7 items-center justify-center rounded-full bg-destaque text-sm font-extrabold text-slate-900">
                {i + 1}
              </span>
            </span>
            <div>
              <h3 class="text-lg font-bold text-slate-900">{p.titulo}</h3>
              <p class="mt-1 text-slate-600">{p.texto}</p>
              {p.valor && (
                <p class="mt-3 inline-block rounded-full bg-marca/10 px-3 py-1 text-sm font-bold text-marca">{p.valor}</p>
              )}
              {p.alerta && (
                <p class="mt-3 flex items-start gap-2 text-sm font-semibold text-amber-800">
                  <TriangleAlert class="mt-0.5 size-4 shrink-0" /> Não faça o exame médico antes do psicotécnico.
                </p>
              )}
            </div>
          </li>
        ))
      }
    </ol>
  </div>
</section>
