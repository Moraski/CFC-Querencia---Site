---
import Logo from '@/components/Logo.astro';
import { site } from '@/data/site';
import { linkWhatsApp } from '@/lib/whatsapp';
const ano = new Date().getFullYear();
---

<footer class="bg-marca-escura py-10 text-sm text-white/80">
  <div class="container-site flex flex-col gap-6 sm:flex-row sm:items-center sm:justify-between">
    <div>
      <Logo claro />
      <p class="mt-3">© {ano} {site.nome}. Centro de Formação de Condutores credenciado pelo Detran-MT.</p>
    </div>
    <p class="flex gap-4 font-semibold">
      <a href={linkWhatsApp()} class="hover:text-white">WhatsApp {site.whatsappFormatado}</a>
      <a href={`https://www.instagram.com/${site.instagram}/`} class="hover:text-white">@{site.instagram}</a>
    </p>
  </div>
</footer>
