---
import { Check, Motorbike, CarFront } from '@lucide/astro';
import { planosDa, incluido, categorias, resumoDa, formatarReais, validadePrecos, type Categoria } from '@/data/pacotes';
import { linkWhatsApp } from '@/lib/whatsapp';
import Orcamento from '@/components/Orcamento';

const abas = Object.keys(categorias) as Categoria[];
---

<!--
  As abas "Moto + carro" / "Só carro" funcionam sem JavaScript: são botões de rádio
  escondidos, e o CSS (seletor :has) mostra a lista do rádio marcado.
-->
<section
  id="planos"
  class="container-site scroll-mt-20 py-16 sm:py-20 [&_[data-lista]]:hidden [&:has(#aba-AB:checked)_[data-lista=AB]]:block [&:has(#aba-B:checked)_[data-lista=B]]:block [&:has(#aba-A:checked)_[data-lista=A]]:block"
>
  <div data-reveal>
    <h2 class="titulo-secao text-center">Planos de aula prática</h2>
    <p class="mx-auto mt-3 max-w-2xl text-center text-slate-600">
      Escolha um plano pronto ou monte o seu na hora da matrícula. A gente passa o valor certinho pelo WhatsApp.
    </p>
  </div>

  <div class="mt-8 flex justify-center" role="radiogroup" aria-label="Categoria">
    <div class="inline-flex rounded-full bg-slate-100 p-1">
      {
        abas.map((c, i) => (
          <label class="cursor-pointer">
            <input type="radio" name="categoria" id={`aba-${c}`} class="peer sr-only" checked={i === 0} />
            <span class="block rounded-full px-4 py-2.5 text-sm font-semibold sm:px-5 sm:text-base text-slate-600 transition peer-checked:bg-marca peer-checked:text-white peer-checked:shadow peer-focus-visible:ring-2 peer-focus-visible:ring-marca">
              {categorias[c].curto}
            </span>
          </label>
        ))
      }
    </div>
  </div>

  {
    abas.map((c) => {
      const lista = planosDa(c);
      const resumo = resumoDa(c);
      return (
        <div data-lista={c}>
        <p class="mt-6 text-center text-slate-700">
          {categorias[c].curto}: a partir de <strong class="text-2xl font-extrabold text-marca">{formatarReais(resumo.aPartirDe, 0)}</strong>
          {' '}à vista ou em até {resumo.parcelas}x no cartão
        </p>
        <ul
          class:list={['mt-10 grid gap-6 sm:grid-cols-2', lista.length === 4 ? 'lg:grid-cols-4' : 'lg:mx-auto lg:max-w-5xl lg:grid-cols-3']}
        >
          {lista.map((p) => (
            <li
              class:list={[
                'relative flex flex-col rounded-3xl border bg-white p-6',
                p.destaque ? 'border-marca shadow-2xl shadow-marca/20 ring-2 ring-marca lg:-translate-y-3' : 'border-slate-200',
              ]}
            >
              {p.destaque && (
                <span class="absolute -top-3 left-6 rounded-full bg-destaque px-3 py-1 text-xs font-bold text-slate-900">
                  Recomendado
                </span>
              )}
              <h3 class="text-xl font-extrabold text-slate-900">{p.nome}</h3>

              <div class="mt-4 flex gap-3">
                {p.aulasMoto > 0 && (
                  <span class="flex flex-1 flex-col items-center rounded-2xl bg-slate-50 py-3">
                    <Motorbike class="size-6 text-marca" />
                    <strong class="mt-1 text-2xl text-slate-900">{p.aulasMoto}</strong>
                    <span class="text-xs text-slate-600">aulas de moto</span>
                  </span>
                )}
                {p.aulasCarro > 0 && (
                  <span class="flex flex-1 flex-col items-center rounded-2xl bg-slate-50 py-3">
                    <CarFront class="size-6 text-marca" />
                    <strong class="mt-1 text-2xl text-slate-900">{p.aulasCarro}</strong>
                    <span class="text-xs text-slate-600">aulas de carro</span>
                  </span>
                )}
              </div>

              <ul class="mt-4 flex-1 space-y-1.5 text-sm">
                {incluido[c].map((item) => (
                  <li class="flex gap-2">
                    <Check class="mt-0.5 size-4 shrink-0 text-marca" /> {item}
                  </li>
                ))}
              </ul>

              <p class="mt-4 text-sm text-slate-600">Parcela em até {p.parcelas}x no cartão</p>

              <a
                href={linkWhatsApp(
                  `Olá! Quero saber o valor do plano ${p.nome} ${categorias[c].curto.toLowerCase()} (` +
                    [p.aulasMoto && `${p.aulasMoto} aulas de moto`, p.aulasCarro && `${p.aulasCarro} aulas de carro`]
                      .filter(Boolean)
                      .join(' + ') +
                    ').',
                )}
                class:list={['mt-6', p.destaque ? 'btn-destaque' : 'btn border-2 border-slate-300 hover:border-marca']}
              >
                Consultar valor no WhatsApp
              </a>
            </li>
          ))}
        </ul>
        </div>
      );
    })
  }

  <p class="mt-8 text-center text-slate-600" data-reveal>
    Quer outra quantidade de aulas?
    <a href={linkWhatsApp('Olá! Quero montar um plano personalizado de aulas práticas.')} class="font-semibold text-marca underline">
      Monte seu plano pelo WhatsApp
    </a>
  </p>
  <p class="mt-3 text-center text-xs text-slate-500">Valores válidos em {validadePrecos}.</p>

  <p class="mx-auto mt-6 max-w-2xl text-center text-sm text-slate-600">
    Taxa do Detran e exames (psicotécnico, médico e toxicológico) são pagos à parte. Explicamos tudo no atendimento.
  </p>

  <!-- client:visible = o React só é baixado quando o formulário aparece na tela -->
  <Orcamento client:visible />
</section>
