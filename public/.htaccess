# Configuração para a hospedagem Hostinger (Apache/LiteSpeed).
# Vai junto na pasta dist/ e deve ficar dentro de public_html.

# Página de erro própria
ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Sempre HTTPS e sem "www"
  RewriteCond %{HTTPS} off [OR]
  RewriteCond %{HTTP_HOST} ^www\. [NC]
  RewriteRule ^ https://cfcquerencia.com%{REQUEST_URI} [L,R=301]
</IfModule>

# Endereços do site antigo (WordPress) → páginas do site novo.
# Redirecionamento 301 avisa o Google que a página mudou de lugar, sem perder a posição nas buscas.
# Quando as páginas internas existirem com esses mesmos endereços, apague a linha correspondente.
Redirect 301 /autoescola-querencia/ https://cfcquerencia.com/
Redirect 301 /primeira-habilitacao/ https://cfcquerencia.com/#como-funciona
Redirect 301 /adicao-de-categoria/ https://cfcquerencia.com/#planos
Redirect 301 /renovacao-de-cnh/ https://cfcquerencia.com/#contato
Redirect 301 /renovacao-cnh/ https://cfcquerencia.com/#contato
Redirect 301 /wp-admin https://cfcquerencia.com/
Redirect 301 /wp-login.php https://cfcquerencia.com/

# Cache longo para arquivos com nome versionado (imagens, CSS e JS gerados pelo Astro)
<IfModule mod_headers.c>
  <FilesMatch "^_astro/">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/jpeg "access plus 1 month"
  ExpiresByType image/webp "access plus 1 month"
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
</IfModule>
